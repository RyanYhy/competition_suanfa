<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="drive_test">
    <physics name="contact_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>800</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.3 0.2 -1</direction>
    </light>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.80 0.85 0.9 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="field_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="body">
        <visual name="ground">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>6 6 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.015 0.015 0.015 1</ambient>
            <diffuse>0.015 0.015 0.015 1</diffuse>
          </material>
        </visual>
        <collision name="ground">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>6 6 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <sensor name="floor_contacts" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact>
            <collision>ground</collision>
          </contact>
          <plugin name="ground_contact_ros" filename="libgazebo_ros_bumper.so">
            <bumperTopicName>/ground_contacts</bumperTopicName>
            <frameName>world</frameName>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
