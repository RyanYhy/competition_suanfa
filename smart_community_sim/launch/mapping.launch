<launch>
  <arg name="start_sim" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="x" default="1.65"/><arg name="y" default="1.75"/><arg name="yaw" default="3.14159"/>
  <param name="use_sim_time" value="true"/>
  <include if="$(arg start_sim)" file="$(find smart_community_sim)/launch/robot.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="x" value="$(arg x)"/><arg name="y" value="$(arg y)"/><arg name="yaw" value="$(arg yaw)"/>
  </include>
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <rosparam command="load" file="$(find smart_community_sim)/config/navigation/gmapping.yaml"/>
    <remap from="scan" to="/scan"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find smart_community_sim)/rviz/navigation.rviz"/>
</launch>
