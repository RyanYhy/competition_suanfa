<launch>
  <!-- Diagnostic mapping alongside navigation. Suppress map->odom TF so AMCL
       remains its sole publisher; this map never feeds navigation in this run. -->
  <param name="use_sim_time" value="true"/>
  <arg name="profile" default="baseline"/>
  <node pkg="gmapping" type="slam_gmapping" name="mapping_observer" output="screen">
    <rosparam if="$(eval arg('profile') == 'baseline')" command="load" file="$(find smart_community_sim)/config/navigation/gmapping.yaml"/>
    <rosparam if="$(eval arg('profile') == 'precise')" command="load" file="$(find smart_community_sim)/config/navigation/gmapping_precise.yaml"/>
    <param name="transform_publish_period" value="0.0"/>
    <remap from="scan" to="/scan"/>
    <remap from="map" to="/mapping_observer/map"/>
    <remap from="map_metadata" to="/mapping_observer/map_metadata"/>
    <remap from="dynamic_map" to="/mapping_observer/dynamic_map"/>
  </node>
</launch>
