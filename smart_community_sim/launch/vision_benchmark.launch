<launch>
  <arg name="localization" default="lidar"/><arg name="planner" default="custom"/>
  <arg name="profile" default="balanced"/><arg name="amcl_profile" default="baseline"/>
  <arg name="map" default="$(find smart_community_sim)/maps/field_reference.yaml"/>
  <arg name="keepout_map" default="$(find smart_community_sim)/maps/competition_keepout.yaml"/>
  <arg name="state" default=""/><arg name="gui" default="false"/>
  <arg name="camera_hfov" default="1.745329"/>
  <arg name="output" default="$(find smart_community_sim)/../doc/validation/识别调试结果"/>
  <arg name="vision_output" default="$(find smart_community_sim)/validation"/>
  <arg name="wall_timeout" default="900"/>
  <arg name="route" default="$(find smart_community_sim)/config/navigation/patrol_route.yaml"/>
  <arg name="vision_config" default="$(find smart_community_sim)/config/vision.yaml"/>
  <!-- Full camera perception and navigation; simulated lamp topics are evaluation only. -->
  <include file="$(find smart_community_sim)/launch/patrol.launch">
    <arg name="localization" value="$(arg localization)"/><arg name="planner" value="$(arg planner)"/>
    <arg name="profile" value="$(arg profile)"/><arg name="amcl_profile" value="$(arg amcl_profile)"/>
    <arg name="map" value="$(arg map)"/><arg name="keepout_map" value="$(arg keepout_map)"/>
    <arg name="state" value="$(arg state)"/><arg name="camera_hfov" value="$(arg camera_hfov)"/><arg name="gui" value="$(arg gui)"/><arg name="rviz" value="false"/>
    <arg name="vision" value="true"/><arg name="traffic_prefix" value="/vision/traffic_lights"/>
    <arg name="vision_output" value="$(arg vision_output)"/>
    <arg name="debug_output" value="$(arg output)"/>
    <arg name="route" value="$(arg route)"/><arg name="vision_config" value="$(arg vision_config)"/>
    <arg name="diagnostics" value="false"/>
    <arg name="save_debug" value="true"/>
  </include>
  <node pkg="smart_community_sim" type="navigation_benchmark.py" name="navigation_benchmark" output="screen" required="true">
    <param name="localization" value="$(arg localization)"/><param name="planner" value="$(arg planner)"/>
    <param name="profile" value="$(arg profile)"/><param name="amcl_profile" value="$(arg amcl_profile)"/>
    <param name="state_file" value="$(arg state)"/>
    <param name="map_file" value="$(arg map)"/>
    <param name="keepout_map_file" value="$(arg keepout_map)"/>
    <param name="output_dir" value="$(arg output)/navigation"/><param name="wall_timeout" value="$(arg wall_timeout)"/>
    <param name="overwrite_report" value="true"/>
  </node>
</launch>
